{
  "name": "dsh-studio-library",
  "version": "0.1.17",
  "type": "module",
  "license": "MIT",
  "description": "工作室控制台与共享运行时组合安装包，业务工作室按需安装",
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.2 || >=0.2.2-rc.1 <0.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/1997liuyh-boop/dsh-studio-library.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-install.mjs",
    "prepare": "node scripts/prepare.mjs",
    "postinstall": "node scripts/install.mjs",
    "pack": "node scripts/pack.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "^4.1.0",
    "typescript": "6.0.3",
    "jsdom": "^26.1.0",
    "semver": "^7.7.3",
    "tar": "^7.4.3",
    "@types/semver": "^7.7.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.0",
    "xterm": "^5.3.0"
  },
  "workspaces": [
    "packages/worktable",
    "packages/runtime"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "experimental",
        "0.2.1-rc.2": "experimental"
      },
      "dsh": "0.2.2-rc.1"
    }
  },
  "bundleDependencies": [
    "dsh-worktable",
    "dsh-studio-projects"
  ],
  "dependencies": {
    "dsh-worktable": "file:packages/worktable",
    "node-pty": "1.2.0-beta.15",
    "semver": "^7.7.3",
    "dsh-studio-projects": "file:packages/runtime",
    "ws": "8.21.3",
    "tar": "^7.4.3"
  },
  "files": [
    "artifacts/*.tgz",
    "artifacts/manifest.json",
    "scripts/install.mjs",
    "catalog.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "packages/worktable/package.json",
    "packages/worktable/lib",
    "packages/worktable/cordis.patch.yml",
    "packages/worktable/dsh.plugin.json",
    "packages/worktable/README.md",
    "packages/worktable/LICENSE",
    "packages/runtime/package.json",
    "packages/runtime/lib",
    "packages/runtime/static",
    "packages/runtime/cordis.patch.yml",
    "packages/runtime/dsh.plugin.json",
    "packages/runtime/README.md",
    "packages/runtime/LICENSE",
    "locale",
    "packages/worktable/locale",
    "packages/runtime/locale"
  ],
  "homepage": "https://github.com/1997liuyh-boop/dsh-studio-library#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "studio",
    "worktable"
  ]
}
