{
  "name": "dsh-worktable",
  "description": "工作室：可折叠的项目抽屉、分屏工作区与会话控制台",
  "version": "0.6.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/1997liuyh-boop/dsh-studio-library.git",
    "directory": "packages/worktable"
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.2 || >=0.2.2-rc.1 <0.2.2"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    },
    "compatibility": {
      "dsh": "0.2.2-rc.1",
      "dshReleases": {
        "0.2.1-rc.2": "experimental",
        "0.2.2-rc.1": "experimental"
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-host-webserver": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "xterm": "^5.3.0"
  },
  "dependencies": {
    "node-pty": "1.2.0-beta.15",
    "ws": "8.21.3"
  },
  "homepage": "https://github.com/1997liuyh-boop/dsh-studio-library#readme",
  "bugs": {
    "url": "https://github.com/1997liuyh-boop/dsh-studio-library/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "studio"
  ]
}
